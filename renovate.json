{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "schedule": "after 3pm on friday",
  "baseBranchPatterns": [
    "main"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "dotnet-sdk",
        "mcr.microsoft.com/dotnet/aspnet",
        "mcr.microsoft.com/dotnet/sdk",
        "MediatR"
      ],
      "enabled": false
    }
  ]
}
